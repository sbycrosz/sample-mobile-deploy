# Stub lanes: prove the pipeline wiring (guard, environment secrets, matrix)
# without a real Revopush/PostHog publish. Secret values are never printed —
# only presence and length, enough to tell the dev/prod sets apart.

SECRET_NAMES = %w[
	REVOPUSH_API_TOKEN
	REVOPUSH_PRIVATE_KEY_BASE64
	POSTHOG_CLI_API_KEY
	POSTHOG_CLI_PROJECT_ID
	POSTHOG_CLI_HOST
].freeze

def stub_publish(platform, options)
	UI.message("[stub] publish_ota platform=#{platform} env=#{options[:env]}")
	missing = SECRET_NAMES.reject { |name| ENV[name].to_s.length.positive? }
	SECRET_NAMES.each do |name|
		value = ENV[name].to_s
		UI.message("  #{name}: #{value.empty? ? 'MISSING' : "set (#{value.length} chars)"}")
	end
	UI.user_error!("missing secrets: #{missing.join(', ')}") unless missing.empty?
	UI.success("[stub] would publish #{platform} OTA to #{options[:env]}")
end

platform :ios do
	lane :publish_ota do |options|
		stub_publish(:ios, options)
	end
end

platform :android do
	lane :publish_ota do |options|
		stub_publish(:android, options)
	end
end
